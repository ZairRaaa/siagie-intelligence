# Conexión SQL Server mediante autenticación integrada de Windows.
# Completa con el nombre de tu instancia si vas a usar el DW.
SQL_SERVER=
SQL_DATABASE=DW_SIAGIE
SQL_DRIVER=ODBC Driver 17 for SQL Server
SQL_TRUSTED_CONNECTION=yes
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERTIFICATE=no

# Asistente GPT opcional. Guarda la clave real solo en .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
